class Solution {
private:
    bool dfs(int node,int col,vector<int>&c,vector<vector<int>>& graph){
        c[node]=col;
         int v=graph.size();
         for(auto it :graph[node]){
            if(c[it]==-1){
                if(dfs(it,!col,c,graph)==false)return false;
            }
            else if(c[it]==col)return false;
         }
         return true;
    }    
public:
    bool isBipartite(vector<vector<int>>& graph) {
        int v=graph.size();
        vector<int>c(v,-1);
        for(int i=0;i<v;i++){
            if(c[i]==-1){
            if(dfs(i,0,c,graph)==false)return false;}
        }
        return true;
    }
};
