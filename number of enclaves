class Solution {
private:
    void bfs(int i,int j,vector<vector<int>>& grid,vector<vector<int>>&vis){
        queue<pair<int,int>>q;
          int n=grid.size();
        int m=grid[0].size();
        q.push({i,j});
        vis[i][j]=1;
        int dr[]={-1,0,1,0};
        int dc[]={0,1,0,-1};
        while(!q.empty()){
            int r=q.front().first;
            int c=q.front().second;
            q.pop();
            for(int i=0;i<4;i++){
                int nr=r+dr[i];
                int nc=c+dc[i];
                if(nr>=0&&nr<n&&nc>=0&&nc<m&&vis[nr][nc]==0&&grid[nr][nc]==1){
                    q.push({nr,nc});
                    vis[nr][nc]=1;
                }
            }
        }
        return;
    }    
public:
    int numEnclaves(vector<vector<int>>& grid) {
        int n=grid.size();
        int m=grid[0].size();
        vector<vector<int>>vis(n,vector<int>(m,0));
        for(int j=0;j<m;j++){
            if(grid[0][j]==1)bfs(0,j,grid,vis);
            if(grid[n-1][j]==1)bfs(n-1,j,grid,vis);
        }
        for(int i=0;i<n;i++){
            if(grid[i][0]==1)bfs(i,0,grid,vis);
            if(grid[i][m-1]==1)bfs(i,m-1,grid,vis);
        }
        int c=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]!=vis[i][j])c++;
            }
        }
        return c;
    }
};
