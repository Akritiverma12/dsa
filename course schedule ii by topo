class Solution {
public:
    vector<int> findOrder(int numCourses, vector<vector<int>>& prerequisites) {
         int V=numCourses;
        vector<vector<int>>adj(V);
        for(auto it:prerequisites){
            int u=it[0];
            int v=it[1];
            adj[v].push_back(u);
        }
        vector<int>in(V,0);
        for(int i=0;i<V;i++){
            for(auto it:adj[i]){
                in[it]++;
            }
        }
        queue<int>q;
        for(int i=0;i<V;i++){
            if(in[i]==0)q.push(i);
        }
        vector<int>topo;
        while(!q.empty()){
            int node=q.front();
            q.pop();
            topo.push_back(node);
            //reduce indegree
            for(auto it:adj[node]){
                in[it]--;
                if(in[it]==0)q.push(it);
            }
        }
       if(topo.size()==V)return topo;
       return {};
    }
};
