class Solution {
private:
   bool dfs(int node,vector<vector<int>> &graph,vector<int>&vis,vector<int>&path,vector<int>&check){
        vis[node]=1;
        path[node]=1;
        check[node]=0;
        for(auto it :graph[node]){
            if(!vis[it]){
                if(dfs(it,graph,vis,path,check)==true){
                    //cycle h thats why check[node]=0
                    check[node]=0;
                    return true;}
            }
            else if(path[it]){
                //cycle h
                check[node]=0;
                return true;}
        }
        //because agar cycle rhega to phle hi break ho jayega ,yaha tk aaya h to definitely cycle nhi h
        check[node]=1;
        path[node]=0;
        return false;
    }    
public:
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        int V=graph.size();
        vector<int>vis(V,0);
        vector<int>path(V,0);
        vector<int>check(V,0);
        vector<int>safe;
        for(int i=0;i<V;i++){
            if(!vis[i]){
                //because each and every node need to be checcked here
                dfs(i,graph,vis,path,check);
            }
        }
        for(int i=0;i<V;i++){
          if(check[i]==1)safe.push_back(i);
        }
        return safe;
    }
};
